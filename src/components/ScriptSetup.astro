---
declare global {
  interface Window {
    swup?: any;
    dataLayer?: any[];
  }
}
---

<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-L2Z37P1555"
></script>
<script>
  const dataLayer = window.dataLayer || (window.dataLayer = []);

  function gtag(...args: unknown[]) {
    dataLayer.push(args);
  }
  gtag("js", new Date());

  gtag("config", "G-L2Z37P1555");
</script>

<script>
  import { OverlayScrollbars } from "overlayscrollbars";

  type OverlayScrollbarsInstance = {
    destroy?: () => void;
  };

  declare global {
    interface Window {
      __scriptSetupCleanup?: () => void;
    }
  }

  const setupScrollBar = () => {
    window.__scriptSetupCleanup?.();

    const bodyInstance = OverlayScrollbars(
      { target: document.body, cancel: { nativeScrollbarsOverlaid: true } },
      {
        scrollbars: {
          theme: "scrollbar-base scrollbar-auto py-1",
          autoHide: "move",
        },
      },
    ) as OverlayScrollbarsInstance;
    document.body.classList.remove("overflow-y-hidden");

    const codeBlockInstances: OverlayScrollbarsInstance[] = [];

    // add scrollbar for code blocks
    document.querySelectorAll("pre").forEach((ele) => {
      const codeBlockInstance = OverlayScrollbars(ele, {
        scrollbars: {
          theme: "scrollbar-base scrollbar-dark px-2",
          autoHide: "leave",
          autoHideDelay: 500,
          autoHideSuspend: false,
        },
      }) as OverlayScrollbarsInstance;

      codeBlockInstances.push(codeBlockInstance);
    });

    window.__scriptSetupCleanup = () => {
      bodyInstance.destroy?.();
      codeBlockInstances.forEach((instance) => instance.destroy?.());
      delete window.__scriptSetupCleanup;
    };
  };

  // init
  const setup = () => {
    setupScrollBar();
  };

  if (window.swup?.hooks) {
    setup();
  } else {
    document.addEventListener("DOMContentLoaded", setup, { once: true });
    document.addEventListener("swup:enable", () => {
      window.swup.hooks.on("content:replace", setup);
    });
    document.addEventListener("page:view", () => {
      if (window.dataLayer) {
        window.dataLayer.push({
          event: "VirtualPageview",
          virtualPageURL: window.location.pathname + window.location.search,
          virtualPageTitle: document.title,
        });
      }
    });
  }
</script>
