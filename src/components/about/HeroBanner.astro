---
import { Image } from "astro:assets";
import BannerImage from "@/assets/banner.svg";
---

<section id="關於我" class="hero-banner">
  <div class="image-section">
    <div class="banner-image-container">
      <Image
        src={BannerImage}
        alt="Banner"
        class="banner-image"
        loading="eager"
        fetchpriority="high"
      />
      <div class="overlay"></div>
    </div>
  </div>

  <div class="content-section">
    <div class="text-content">
      <h1 class="hero-title">Brian Chou</h1>
      <div class="typing-container">
        <div class="text-lines">
          <div class="text-line" id="line-0"></div>
          <div class="text-line" id="line-1"></div>
          <div class="text-line" id="line-2"></div>
        </div>
        <span class="cursor">|</span>
      </div>
    </div>
  </div>
</section>

<script>
  import { createScriptLifecycle } from "@/utils/script-lifecycle";

  type AnimationCleanup = () => void;

  declare global {
    interface Window {
      __heroBannerCleanup?: AnimationCleanup;
    }
  }

  const startAnimation = () => {
    // Swup 會在導頁後重新執行元件內的 script。先停止上一個首頁
    // 留下的計時器與動畫，避免每次回到首頁都多一組更新工作。
    const lifecycle = createScriptLifecycle("__heroBannerCleanup");

    const texts = ["嗨嗨，", "我叫 Brian 也可以叫我海獺，", "很高興認識你！"];
    const lineElements = texts.map((_, index) =>
      document.getElementById(`line-${index}`),
    ) as Array<HTMLElement | null>;
    const cursor = document.querySelector(".cursor") as HTMLElement | null;
    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    const measurementCanvas = document.createElement("canvas");
    const measurementContext = measurementCanvas.getContext("2d");
    const lineMeasurements = new Map<
      number,
      { top: number; widths: number[] }
    >();

    const refreshMeasurements = () => {
      lineElements.forEach((element, index) => {
        if (!element) return;

        const style = getComputedStyle(element);
        const font = `${style.fontStyle} ${style.fontVariant} ${style.fontWeight} ${style.fontSize} ${style.fontFamily}`;
        const widths: number[] = [0];

        if (measurementContext) {
          measurementContext.font = font;
          let prefix = "";

          for (const character of texts[index]) {
            prefix += character;
            widths.push(measurementContext.measureText(prefix).width);
          }
        }

        lineMeasurements.set(index, {
          top: element.offsetTop,
          widths,
        });
      });
    };

    const { addDisposer, schedule } = lifecycle;

    let textIndex = 0;
    let charIndex = 0;
    let currentText = "";

    const updateCursorPosition = () => {
      if (!cursor) return;

      const lineIndex =
        textIndex >= texts.length ? texts.length - 1 : textIndex;
      const lineElement = lineElements[lineIndex];
      const measurement = lineMeasurements.get(lineIndex);

      if (!lineElement || !measurement) return;

      const currentLength = currentText.length;
      const textWidth =
        measurement.widths[
          Math.min(currentLength, measurement.widths.length - 1)
        ] || 0;

      cursor.style.left = `${textWidth + 2}px`;
      cursor.style.top = `${measurement.top}px`;
    };

    function typeWriter() {
      if (lifecycle.isDestroyed()) return;

      if (textIndex >= texts.length) {
        cursor?.classList.add("typing-complete");
        return;
      }

      const fullText = texts[textIndex];
      currentText = fullText.substring(0, charIndex + 1);
      charIndex++;

      updateDisplay();

      if (charIndex >= fullText.length) {
        // 當前行打完，移到下一行
        textIndex++;
        charIndex = 0;
        currentText = "";
        updateCursorPosition();

        // 短暫停頓後繼續下一行
        schedule(typeWriter, 320);
        return;
      }

      const speed = 55;
      schedule(typeWriter, speed);
    }

    function updateDisplay() {
      const currentLineElement = lineElements[textIndex];
      if (currentLineElement) {
        currentLineElement.textContent = currentText;
      }
      updateCursorPosition();
    }

    refreshMeasurements();

    if (prefersReducedMotion) {
      lineElements.forEach((lineElement, index) => {
        if (lineElement) lineElement.textContent = texts[index];
      });
      cursor?.classList.add("typing-complete");
    } else {
      // 只播放一次，避免使用者往下瀏覽時仍持續修改首頁 DOM。
      schedule(typeWriter, 80);
    }

    // 視窗大小改變時重新定位游標
    const syncCursorPosition = () => {
      refreshMeasurements();
      updateCursorPosition();
    };

    window.addEventListener("resize", syncCursorPosition);
    addDisposer(() => window.removeEventListener("resize", syncCursorPosition));

    // 標題動畫
    const titleElement = document.querySelector<HTMLElement>(".hero-title");

    const titleAnimation = prefersReducedMotion || !titleElement
      ? null
      : titleElement.animate(
          [
            { transform: "translateY(18px)" },
            { transform: "translateY(0)" },
          ],
          {
            duration: 320,
            easing: "ease-out",
            fill: "forwards",
          },
        );

    if (prefersReducedMotion) {
      document.querySelector<HTMLElement>(".hero-title")?.style.setProperty(
        "opacity",
        "1",
      );
      document
        .querySelector<HTMLElement>(".typing-container")
        ?.style.setProperty("opacity", "1");
    }

    window.__heroBannerCleanup = () => {
      lifecycle.destroy();
      titleAnimation?.cancel();
    };
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", startAnimation, {
      once: true,
    });
  } else {
    startAnimation();
  }
</script>

<style>
  @reference "../../styles/global.css";
  .hero-banner {
    position: relative;
    height: 100vh;
    height: 100dvh;
    width: 100vw;
    display: flex;
    flex-direction: column;
    margin-left: calc(-50vw + 50%);
    overflow: hidden;
  }

  .image-section {
    position: relative;
    height: 35vh;
    width: 100%;
    overflow: hidden;
  }

  .banner-image-container {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .banner-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .content-section {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }

  .text-content {
    text-align: left;
    max-width: 800px;
    width: 100%;
  }

  .hero-title {
    font-size: clamp(3rem, 10vw, 6rem);
    font-weight: 700;
    margin: 0 0 2rem 0;
    text-shadow: none;
    font-family: var(--brand-font);
    opacity: 1;
    color: var(--text-color);
  }

  .typing-container {
    font-size: clamp(1.3rem, 4vw, 2rem);
    min-height: 4rem;
    display: block;
    text-shadow: none;
    opacity: 1;
    position: relative;
    color: var(--text-color-lighten);
  }

  .text-lines {
    position: relative;
    min-height: calc(1.6em * 3); /* 固定高度容納3行文字 */
  }

  .text-line {
    font-family: var(--primary-font);
    line-height: 1.6;
    text-align: left;
    display: block;
    height: 1.6em;
    margin: 0;
    padding: 0;
  }

  .cursor {
    display: inline-block;
    margin-left: 0px;
    animation: blink 1s infinite;
    font-weight: bold;
    color: var(--text-color-lighten);
    position: absolute;
    top: 0;
    left: 0;
    pointer-events: none;
  }

  .cursor.typing-complete {
    display: none;
  }

  @keyframes blink {
    0%,
    50% {
      opacity: 1;
    }
    51%,
    100% {
      opacity: 0;
    }
  }

  /* 手機版優化 */
  @media (max-width: 768px) {
    .hero-banner {
      height: 100vh;
      height: 100dvh;
    }

    .image-section {
      height: 30vh;
    }

    .content-section {
      padding: 1.5rem;
    }

    .hero-title {
      margin-bottom: 1.5rem;
    }

    .typing-container {
      min-height: 3rem;
      font-size: clamp(1.1rem, 5vw, 1.4rem);
    }
  }

  /* 極小螢幕優化 */
  @media (max-width: 480px) {
    .image-section {
      height: 25vh;
    }

    .content-section {
      padding: 1rem;
    }

    .hero-title {
      margin-bottom: 1rem;
    }
  }

  /* 大螢幕優化 */
  @media (min-width: 1200px) {
    .content-section {
      padding: 3rem;
    }

    .text-content {
      max-width: 1000px;
    }
  }

  /* 橫向模式優化 */
  @media (orientation: landscape) and (max-height: 600px) {
    .image-section {
      height: 40vh;
    }

    .hero-title {
      font-size: clamp(2rem, 8vw, 3.5rem);
      margin-bottom: 1rem;
    }

    .typing-container {
      font-size: clamp(1rem, 3vw, 1.3rem);
    }
  }

  /* 減少動畫偏好設定支援 */
  @media (prefers-reduced-motion: reduce) {
    .cursor {
      animation: none;
    }

    * {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
