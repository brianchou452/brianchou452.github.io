---
import { Image } from "astro:assets";
import BannerImage from "@/assets/banner.svg";
---

<section id="關於我" class="hero-banner">
  <div class="image-section">
    <div class="banner-image-container">
      <Image
        src={BannerImage}
        format="webp"
        width={2560}
        height={1280}
        quality={90}
        alt="Banner"
        class="banner-image"
        loading="eager"
        fetchpriority="high"
      />
      <div class="overlay"></div>
    </div>
  </div>

  <div class="content-section">
    <div class="text-content">
      <h1 class="hero-title">Brian Chou</h1>
      <div
        class="typing-container"
        aria-label="嗨嗨，我叫 Brian 也可以叫我海獺，很高興認識你！"
      >
        <div class="text-lines" aria-hidden="true">
          <div class="text-line" data-typing-line data-text="嗨嗨，"></div>
          <div
            class="text-line"
            data-typing-line
            data-text="我叫 Brian 也可以叫我海獺，"></div>
          <div
            class="text-line"
            data-typing-line
            data-text="很高興認識你！"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import {
    createScriptLifecycle,
    initializeOnPageLoad,
  } from "@/utils/script-lifecycle";

  type AnimationCleanup = () => void;

  declare global {
    interface Window {
      __heroBannerCleanup?: AnimationCleanup;
    }
  }

  const startAnimation = () => {
    // 每次回到首頁時先停止上一輪留下的計時器與動畫，避免重複工作。
    const lifecycle = createScriptLifecycle("__heroBannerCleanup");
    const hero = document.querySelector<HTMLElement>("main .hero-banner");

    if (!hero) return;

    const lineElements = Array.from(
      hero.querySelectorAll<HTMLElement>("[data-typing-line]"),
    );
    const texts = lineElements.map((element) => element.dataset.text ?? "");
    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    const { addDisposer, schedule } = lifecycle;
    const characterInterval = 50;
    const linePause = 250;
    const startDelay = 80;
    const replayDelay = 5000;
    const renderedLengths = texts.map(() => -1);
    const lineStartTimes: number[] = [];
    let nextLineStart = startDelay;
    let activeLine = -1;
    let animationFrame: number | null = null;

    texts.forEach((text) => {
      lineStartTimes.push(nextLineStart);
      nextLineStart += text.length * characterInterval + linePause;
    });

    const setActiveLine = (index: number) => {
      if (activeLine === index) return;

      if (activeLine >= 0) {
        lineElements[activeLine]?.classList.remove("is-typing");
      }

      activeLine = index;

      if (activeLine >= 0) {
        lineElements[activeLine]?.classList.add("is-typing");
      }
    };

    const renderLine = (index: number, length: number) => {
      if (renderedLengths[index] === length) return;

      renderedLengths[index] = length;
      lineElements[index].textContent = texts[index].slice(0, length);
    };

    const animateTyping = () => {
      const finalLine = texts.length - 1;
      const finishedAt =
        lineStartTimes[finalLine] + texts[finalLine].length * characterInterval;
      let startedAt: number | null = null;

      const renderFrame = (timestamp: number) => {
        if (lifecycle.isDestroyed()) return;

        startedAt ??= timestamp;
        const elapsed = timestamp - startedAt;
        let nextActiveLine = elapsed < startDelay ? 0 : -1;

        texts.forEach((text, index) => {
          const localElapsed = elapsed - lineStartTimes[index];
          const visibleLength =
            localElapsed < 0
              ? 0
              : Math.min(
                  text.length,
                  Math.floor(localElapsed / characterInterval) + 1,
                );

          renderLine(index, visibleLength);

          const followingLineStart = lineStartTimes[index + 1];
          if (
            localElapsed >= 0 &&
            (visibleLength < text.length ||
              (followingLineStart !== undefined && elapsed < followingLineStart))
          ) {
            nextActiveLine =
              visibleLength === text.length && followingLineStart !== undefined
                ? index + 1
                : index;
          }
        });

        if (elapsed >= finishedAt) {
          texts.forEach((text, index) => renderLine(index, text.length));
          setActiveLine(-1);
          animationFrame = null;

          schedule(() => {
            texts.forEach((_, index) => renderLine(index, 0));
            animateTyping();
          }, replayDelay);
          return;
        }

        setActiveLine(nextActiveLine);
        animationFrame = requestAnimationFrame(renderFrame);
      };

      setActiveLine(0);
      animationFrame = requestAnimationFrame(renderFrame);
    };

    if (prefersReducedMotion) {
      lineElements.forEach((lineElement, index) => {
        lineElement.textContent = texts[index];
      });
    } else {
      animateTyping();
    }

    addDisposer(() => {
      if (animationFrame !== null) cancelAnimationFrame(animationFrame);
    });

    // 標題動畫
    const titleElement = hero.querySelector<HTMLElement>(".hero-title");

    const titleAnimation = prefersReducedMotion || !titleElement
      ? null
      : titleElement.animate(
          [
            { transform: "translateY(18px)" },
            { transform: "translateY(0)" },
          ],
          {
            duration: 320,
            easing: "ease-out",
            fill: "forwards",
          },
        );

    if (prefersReducedMotion) {
      hero.querySelector<HTMLElement>(".hero-title")?.style.setProperty(
        "opacity",
        "1",
      );
      hero
        .querySelector<HTMLElement>(".typing-container")
        ?.style.setProperty("opacity", "1");
    }

    window.__heroBannerCleanup = () => {
      lifecycle.destroy();
      titleAnimation?.cancel();
    };
  };

  initializeOnPageLoad(startAnimation);
</script>

<style>
  @reference "../../styles/global.css";
  .hero-banner {
    position: relative;
    height: 100vh;
    height: 100dvh;
    width: 100vw;
    display: flex;
    flex-direction: column;
    margin-left: calc(-50vw + 50%);
    overflow: hidden;
  }

  .image-section {
    position: relative;
    height: 35vh;
    width: 100%;
    overflow: hidden;
  }

  .banner-image-container {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .banner-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .content-section {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }

  .text-content {
    text-align: left;
    max-width: 800px;
    width: 100%;
  }

  .hero-title {
    font-size: clamp(3rem, 10vw, 6rem);
    font-weight: 700;
    margin: 0 0 2rem 0;
    text-shadow: none;
    font-family: var(--brand-font);
    opacity: 1;
    color: var(--text-color);
  }

  .typing-container {
    font-size: clamp(1.3rem, 4vw, 2rem);
    min-height: 4rem;
    display: block;
    text-shadow: none;
    opacity: 1;
    position: relative;
    color: var(--text-color-lighten);
  }

  .text-lines {
    position: relative;
    min-height: calc(1.6em * 3); /* 固定高度容納3行文字 */
  }

  .text-line {
    font-family: var(--primary-font);
    line-height: 1.6;
    text-align: left;
    display: block;
    height: 1.6em;
    margin: 0;
    padding: 0;
  }

  .text-line.is-typing::after {
    content: "|";
    display: inline-block;
    margin-inline-start: 2px;
    animation: blink 1s infinite;
    font-weight: bold;
    color: var(--text-color-lighten);
    pointer-events: none;
  }

  @keyframes blink {
    0%,
    50% {
      opacity: 1;
    }
    51%,
    100% {
      opacity: 0;
    }
  }

  /* 手機版優化 */
  @media (max-width: 768px) {
    .hero-banner {
      height: 100vh;
      height: 100dvh;
    }

    .image-section {
      height: 30vh;
    }

    .content-section {
      padding: 1.5rem;
    }

    .hero-title {
      margin-bottom: 1.5rem;
    }

    .typing-container {
      min-height: 3rem;
      font-size: clamp(1.1rem, 5vw, 1.4rem);
    }
  }

  /* 極小螢幕優化 */
  @media (max-width: 480px) {
    .image-section {
      height: 25vh;
    }

    .content-section {
      padding: 1rem;
    }

    .hero-title {
      margin-bottom: 1rem;
    }
  }

  /* 大螢幕優化 */
  @media (min-width: 1200px) {
    .content-section {
      padding: 3rem;
    }

    .text-content {
      max-width: 1000px;
    }
  }

  /* 橫向模式優化 */
  @media (orientation: landscape) and (max-height: 600px) {
    .image-section {
      height: 40vh;
    }

    .hero-title {
      font-size: clamp(2rem, 8vw, 3.5rem);
      margin-bottom: 1rem;
    }

    .typing-container {
      font-size: clamp(1rem, 3vw, 1.3rem);
    }
  }

  /* 減少動畫偏好設定支援 */
  @media (prefers-reduced-motion: reduce) {
    .text-line.is-typing::after {
      animation: none;
    }

    * {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
