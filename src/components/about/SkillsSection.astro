---
import SkillCard from "./SkillCard.astro";
import { getLangFromUrl } from "@/i18n/utils";
import { getEntry } from "astro:content";

const lang = getLangFromUrl(Astro.url);

const skillCategories = await getEntry("skills", `${lang}/skills`);
---

<section
  id="skills"
  class="py-12 my-12 bg-linear-to-b from-(--background-color) to-(--card-color-transparent)"
>
  <div class="container max-w-4xl mx-auto px-6 md:px-4">
    <div class="motion-wrapper" data-motion="fadeInUp">
      <h2
        class="text-2xl font-bold mb-8 text-center md:text-left text-(--text-color)"
      >
        🛠️ Skills
      </h2>
    </div>

    <div class="skills-container space-y-6" data-motion="container">
      {
        skillCategories?.data.map((category) => (
          <div data-motion="slideInUp">
            <SkillCard
              title={category.title}
              icon={category.icon}
              skills={category.skills}
            />
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* 初始隱藏所有動畫元素 */
  [data-motion] {
    opacity: 0;
  }

  /* 動畫後的最終狀態 */
  [data-motion].animate {
    opacity: 1;
  }

  /* 標題動畫 */
  [data-motion="fadeInUp"] {
    transform: translateY(30px);
    transition:
      opacity 0.35s ease-out,
      transform 0.35s ease-out;
  }

  [data-motion="fadeInUp"].animate {
    transform: translateY(0);
  }

  /* 卡片容器動畫 */
  [data-motion="container"] {
    transition: opacity 0.3s ease-out;
  }

  /* 個別卡片動畫 */
  [data-motion="slideInUp"] {
    transform: translateY(20px);
    transition:
      opacity 0.32s ease-out,
      transform 0.32s ease-out;
  }

  [data-motion="slideInUp"].animate {
    transform: translateY(0);
  }

  @media (max-width: 768px) {
    [data-motion] {
      transition-duration: 0.3s !important;
    }
  }
</style>

<script>
  import { createScriptLifecycle } from "@/utils/script-lifecycle";

  declare global {
    interface Window {
      __skillsSectionCleanup?: () => void;
    }
  }

  const initializeAnimations = () => {
    // Swup 導頁後會重新執行這段 script；移除前一頁留下的 observers。
    const lifecycle = createScriptLifecycle("__skillsSectionCleanup");
    const { addDisposer } = lifecycle;

    const observeOnce = (
      element: Element,
      callback: () => void,
      threshold: number,
    ) => {
      const observer = new IntersectionObserver(
        ([entry]) => {
          if (!entry?.isIntersecting) return;

          callback();
          observer.disconnect();
        },
        { threshold, rootMargin: "0px 0px 40px 0px" },
      );

      observer.observe(element);
      addDisposer(() => observer.disconnect());
    };

    // 標題動畫
    const titleElement = document.querySelector('[data-motion="fadeInUp"]');
    if (titleElement) {
      observeOnce(
        titleElement,
        () => titleElement.classList.add("animate"),
        0.1,
      );
    }

    // 容器動畫
    const containerElement = document.querySelector(
      '[data-motion="container"]',
    );
    if (containerElement) {
      observeOnce(
        containerElement,
        () => {
          containerElement.classList.add("animate");

          // 卡片進入視窗後一起顯示，避免背景分頁的 timer throttling
          // 讓使用者捲到這裡時仍需逐張等待。
          const cards = containerElement.querySelectorAll(
            '[data-motion="slideInUp"]',
          );
          cards.forEach((card) => {
            card.classList.add("animate");

            const skillTags = card.querySelectorAll(".skill-tag");
            skillTags.forEach((tag) => {
              (tag as HTMLElement).style.opacity = "1";
              (tag as HTMLElement).style.transform = "scale(1)";
            });
          });
        },
        0.05,
      );
    }

    window.__skillsSectionCleanup = () => {
      lifecycle.destroy();
    };
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initializeAnimations, {
      once: true,
    });
  } else {
    initializeAnimations();
  }
</script>
