---
interface Props {
  size?: number;
  class?: string;
}

const { size = 24, class: className } = Astro.props;
---

<!--
  Keep the GitHub mark inline so Astro's image pipeline never rasterizes it.
  This icon must retain currentColor support for light/dark themes.
-->
<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="currentColor"
  class={className}
  aria-hidden="true"
  focusable="false"
  data-icon="github"
>
